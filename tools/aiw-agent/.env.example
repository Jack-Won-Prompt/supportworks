# ── 서버 연결 ─────────────────────────────────────────────────────────────
SW_BASE_URL=https://www.supportworks.co.kr
# 설정 > AI 작업 PC 에서 등록할 때 한 번만 표시되는 토큰. 다시 볼 수 없다.
SW_AGENT_TOKEN=

# ── Reverb (서버 .env 와 같은 값) ─────────────────────────────────────────
REVERB_APP_KEY=
REVERB_HOST=www.supportworks.co.kr
REVERB_PORT=443
REVERB_SCHEME=https

# ── Claude ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Windows 필수: Git Bash 경로. CLAUDE_CODE_GIT_BASH_PATH 로 SDK 프로세스에 전달된다.
# 데몬이 직접 셸을 띄우지는 않는다. macOS/Linux 는 비워 둔다.
SW_SHELL=C:\Program Files\Git\bin\bash.exe

# ── 실행 ──────────────────────────────────────────────────────────────────
HEARTBEAT_SEC=30
# PC 전체 동시 실행 상한. 같은 폴더(local_path)는 이 값과 무관하게 항상 직렬이다.
MAX_PARALLEL_JOBS=2
JOB_TIMEOUT_SEC=1800
IDLE_TIMEOUT_SEC=300
SESSION_MAX_SEC=7200

# job 의 context_limit_tokens 대비 이 비율에 닿으면 인수인계로 세션을 교체한다.
# 한도 자체는 서버가 job 마다 내려준다(.env 에 두지 않는다).
CONTEXT_HANDOVER_RATIO=0.6

HANDOVER_DIR=docs/aiw/handover
LOG_DIR=./logs
RESUME_ON_RESTART=true
INBOX_POLL_SEC=30
